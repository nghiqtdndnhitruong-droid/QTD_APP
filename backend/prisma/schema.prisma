generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum IdentityCardType {
  CAN_CUOC // Căn cước -> Bộ Công An
  CCCD     // Căn cước công dân -> Cục CSQLHC về TTXH
}

enum Gender {
  NAM // Nam (số thứ 4 là 0 hoặc 2)
  NU  // Nữ (số thứ 4 là 1 hoặc 3)
}

enum HeirRelationship {
  VO    // Vợ
  CHONG // Chồng
  CON   // Con
  CHA   // Cha
  ME    // Mẹ
}

enum RelatedPersonRelationship {
  CON // Con
  CHA // Cha
  ME  // Mẹ
  ANH // Anh
  CHI // Chị
  EM  // Em
  CO  // Cô
  DI  // Dì
  CAU // Cậu
}

enum LoanType {
  TIN_CHAP // Tín chấp (tối đa 100.000.000đ)
  THE_CHAP // Thế chấp (tối đa 70% tổng định giá tài sản)
}

enum LoanDurationType {
  NGAN_HAN  // Ngắn hạn (mặc định 12 tháng)
  TRUNG_HAN // Trung hạn (mặc định 24 tháng)
}

enum LoanStatus {
  DANG_CHUAN_BI_HO_SO // Đang chuẩn bị hồ sơ
  DA_HOAN_THANH_HO_SO // Đã hoàn thành hồ sơ
  DA_GIAI_NGAN        // Đã giải ngân
  DA_TAT_TOAN         // Đã tất toán
  QUA_HAN             // Quá hạn
}

enum CollateralAssetType {
  QSDD               // Quyền sử dụng đất
  QSDD_NHA_O_TAI_SAN // Quyền sử dụng đất quyền sở hữu nhà ở và tài sản khác gắn liền với đất
  QSDD_TAI_SAN       // Quyền sử dụng đất, quyền sở hữu tài sản gắn liền với đất
}

enum CertificateType {
  GCN               // GCN
  GIAY_CHUNG_NHAN   // Giấy chứng nhận
  VAO_SO_CAP_GCN_SO // Vào sổ cấp giấy chứng nhận quyền sử dụng đất Số
  SO_VAO_SO_CAP_GCN // Số vào sổ cấp giấy chứng nhận quyền sử dụng đất
}

enum CollateralOwnerType {
  NGUOI_VAY_CA_NHAN     // Người vay cá nhân
  NGUOI_VAY_HO          // Người vay hộ
  NGUOI_THUA_KE_CA_NHAN // Người thừa kế cá nhân
  NGUOI_THUA_KE_HO      // Người thừa kế hộ
  BAO_LANH              // Bảo lãnh
}

enum ValuationType {
  QUY_DINH_QUY // Định giá theo Nghị định/Quy định Quỹ
  THI_TRUONG   // Định giá theo giá thị trường
}

enum FundLandCategory {
  DAT_BINH_THUONG    // Đất bình thường (x 60.000đ)
  DAT_CAP_KENH       // Đất cập kênh (x 70.000đ)
  DAT_CAP_LO_DAT     // Đất cập lộ đất (x 100.000đ)
  DAT_CAP_DUONG_NHUA // Đất cập đường nhựa (x 150.000đ)
}

enum LoanPlanItemType {
  CHI_PHI   // Chi phí
  NGUON_THU // Nguồn thu
}

// ==========================================
// MODELS: AUTHENTICATION & ĐỊA BÀN QUẢN LÝ
// ==========================================

/// Tài khoản Cán bộ tín dụng (Người dùng hệ thống)
model CreditOfficer {
  id               String           @id @default(uuid())
  username         String           @unique @db.VarChar(100)
  passwordHash     String
  fullName         String
  idType           IdentityCardType
  idNumber         String           @unique @db.VarChar(12)
  issuingAuthority String
  issueDate        DateTime         @db.Date
  gender           Gender
  birthYear        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  territoryGroups TerritoryGroup[]
  communes        Commune[]
  hamlets         Hamlet[]
  borrowers       Borrower[]
  loans           Loan[]

  @@index([fullName])
  @@map("credit_officers")
}

/// Nhóm địa bàn (Do cán bộ tự tạo và đặt tên để phân vùng kiểm soát cấp Xã)
model TerritoryGroup {
  id        String        @id @default(uuid())
  officerId String
  officer   CreditOfficer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  name      String        // Tên nhóm do cán bộ tự đặt (VD: Nhóm 1, Nhóm 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  communes Commune[]

  @@unique([officerId, name])
  @@index([officerId])
  @@map("territory_groups")
}

/// Cấp Xã trong Địa bàn quản lý (Tỉnh mặc định là Tỉnh Vĩnh Long, mỗi Xã có nhiều Ấp)
model Commune {
  id               String          @id @default(uuid())
  officerId        String
  officer          CreditOfficer   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  territoryGroupId String?
  territoryGroup   TerritoryGroup? @relation(fields: [territoryGroupId], references: [id], onDelete: SetNull)
  name             String          // Tên xã (VD: Xã Nhị Trường)
  province         String          @default("Tỉnh Vĩnh Long")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  hamlets          Hamlet[]
  collateralAssets CollateralAsset[]

  @@unique([officerId, name])
  @@index([officerId])
  @@index([territoryGroupId])
  @@map("communes")
}

/// Cấp Ấp trong Địa bàn quản lý (Thuộc 1 Xã)
model Hamlet {
  id        String        @id @default(uuid())
  officerId String
  officer   CreditOfficer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  communeId String
  commune   Commune       @relation(fields: [communeId], references: [id], onDelete: Cascade)
  name      String        // Tên ấp (VD: Ấp Nô Lựa)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  borrowers        Borrower[]
  collateralAssets CollateralAsset[]

  @@unique([communeId, name])
  @@index([officerId])
  @@index([communeId])
  @@map("hamlets")
}

// ==========================================
// MODELS: NGHIỆP VỤ TÍN DỤNG
// ==========================================

/// Đợt ban hành Biểu lãi suất (kèm Thời gian ban hành, Ghi chú thông tư, và trạng thái Áp dụng)
model InterestRateBatch {
  id            String             @id @default(uuid())
  effectiveDate DateTime           @db.Date // Thời gian ban hành (dd/mm/yyyy)
  documentNote  String?            // Ghi chú (Số thông tư ban hành)
  isApplied     Boolean            @default(false) // Đợt lãi suất đang được áp dụng
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tiers InterestRateTier[]

  @@index([isApplied])
  @@index([effectiveDate])
  @@map("interest_rate_batches")
}

/// Bảng cấu hình các mốc lãi suất theo Loại vay & Thời hạn vay
model InterestRateTier {
  id           String             @id @default(uuid())
  batchId      String?
  batch        InterestRateBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  loanType     LoanType
  durationType LoanDurationType
  minAmount    Decimal            @db.Decimal(18, 0)
  maxAmount    Decimal?           @db.Decimal(18, 0) // null nếu không giới hạn trên (VD: >= 500tr)
  interestRate Decimal            @db.Decimal(6, 3)  // Mức lãi suất (%)
  description  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([batchId])
  @@index([loanType, durationType, isActive, minAmount])
  @@map("interest_rate_tiers")
}

/// Thông tin Người vay (Khách hàng) - Địa chỉ lấy từ danh sách địa bàn (Ấp - Xã - Tỉnh Vĩnh Long)
model Borrower {
  id               String           @id @default(uuid())
  officerId        String
  officer          CreditOfficer    @relation(fields: [officerId], references: [id], onDelete: Restrict)
  hamletId         String
  hamlet           Hamlet           @relation(fields: [hamletId], references: [id], onDelete: Restrict)
  fullName         String
  idType           IdentityCardType
  idNumber         String           @unique @db.VarChar(12)
  issuingAuthority String
  issueDate        DateTime         @db.Date
  expiryDate       DateTime?        @db.Date
  gender           Gender
  birthYear        Int
  address          String           // Tự động ghép từ địa bàn: "Ấp ..., Xã ..., Tỉnh Vĩnh Long"
  memberCode       String?
  phone            String?          @db.VarChar(20)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  heir  Heir?
  loans Loan[]

  @@index([officerId])
  @@index([hamletId])
  @@index([fullName])
  @@index([memberCode])
  @@map("borrowers")
}

/// Thông tin Người thừa kế (1 Người vay có tối đa 1 Người thừa kế hoặc không có - địa chỉ nhập tự do)
model Heir {
  id               String           @id @default(uuid())
  borrowerId       String           @unique
  borrower         Borrower         @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  fullName         String
  idType           IdentityCardType
  idNumber         String           @db.VarChar(12)
  issuingAuthority String
  issueDate        DateTime         @db.Date
  expiryDate       DateTime?        @db.Date
  gender           Gender
  birthYear        Int
  address          String
  phone            String?          @db.VarChar(20)
  relationship     HeirRelationship
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([idNumber])
  @@map("heirs")
}

/// Thông tin Khoản vay (Gắn trực tiếp Cán bộ tín dụng quản lý)
model Loan {
  id                        String           @id @default(uuid())
  officerId                 String
  officer                   CreditOfficer    @relation(fields: [officerId], references: [id], onDelete: Restrict)
  borrowerId                String
  borrower                  Borrower         @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  loanDate                  DateTime         @db.Date // Ngày vay (dd/mm/yyyy)
  disbursementDate          DateTime?        @db.Date // Ngày giải ngân (tùy chọn khi lập hồ sơ)
  loanAmount                Decimal          @db.Decimal(18, 0) // Số tiền vay
  indentureNumber           String?          @unique // Số khế ước (tùy chọn với Tín chấp, bắt buộc với Thế chấp)
  loanType                  LoanType         // Tín chấp / Thế chấp
  durationType              LoanDurationType // Ngắn hạn / Trung hạn
  durationMonths            Int              // Mặc định 12 (Ngắn hạn) hoặc 24 (Trung hạn)
  interestRate              Decimal          @db.Decimal(6, 3) // Lãi suất
  dueDate                   DateTime?        @db.Date // Ngày tới hạn trả (tính từ ngày giải ngân)
  status                    LoanStatus       @default(DANG_CHUAN_BI_HO_SO) // Trạng thái khoản vay
  mortgageContractNumber    String?          // Số hợp đồng thế chấp (bắt buộc nếu thế chấp)
  committeeNotarizationDate DateTime?        @db.Date // Ngày chứng thực ủy ban (tùy chọn khi tạo thế chấp, nhập sau trong edit)
  mortgageContractTermDate  DateTime?        @db.Date // Thời hạn hợp đồng thế chấp (nếu thế chấp)
  valuationDate             DateTime?        @db.Date // Ngày định giá tài sản thế chấp
  valuationType             ValuationType?   // Loại định giá tài sản thế chấp (QUY_DINH_QUY / THI_TRUONG)
  totalCollateralValuation  Decimal?         @db.Decimal(18, 0) // Tổng giá trị định giá tài sản thế chấp
  maxAllowedLoanAmount      Decimal?         @db.Decimal(18, 0) // Hạn mức tối đa (100tr hoặc 70% tổng định giá)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  collateralAssets CollateralAsset[]
  valuationItems   CollateralValuationItem[]
  relatedPersons   RelatedPerson[]
  householdMembers HouseholdMember[]
  loanPlan         LoanPlan?

  @@index([officerId])
  @@index([borrowerId])
  @@index([loanType, durationType])
  @@index([status])
  @@index([dueDate])
  @@index([loanDate])
  @@index([disbursementDate])
  @@map("loans")
}

/// Tài sản thế chấp (Chỉ nhận Quyền sử dụng đất, địa chỉ lấy từ danh sách địa bàn cấp Ấp hoặc cấp Xã)
model CollateralAsset {
  id                String              @id @default(uuid())
  loanId            String
  loan              Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  hamletId          String?
  hamlet            Hamlet?             @relation(fields: [hamletId], references: [id], onDelete: Restrict)
  communeId         String?
  commune           Commune?            @relation(fields: [communeId], references: [id], onDelete: Restrict)
  assetType         CollateralAssetType
  assetCode         String              // Mã số tài sản
  certificateType   CertificateType     // Loại giấy chứng nhận
  certificateNumber String              // Số giấy chứng nhận
  plotNumber        String              // Số thửa
  mapSheetNumber    String              // Số tờ
  address           String              // Tự động ghép từ địa bàn: "Ấp ..., Xã ..., Tỉnh Vĩnh Long" hoặc "Xã ..., Tỉnh Vĩnh Long"
  area              Decimal             @db.Decimal(14, 2) // Diện tích (m2)
  usageForm         String?             // Hình thức sử dụng (tùy chọn)
  usagePurpose      String?             // Mục đích sử dụng (tùy chọn)
  usageTerm         String              // Thời hạn sử dụng
  usageOrigin       String?             // Nguồn gốc sử dụng (tùy chọn)
  usageRestriction  String?             // Hạn chế sử dụng (tùy chọn)
  ownerType         CollateralOwnerType // Chủ sở hữu tài sản
  valuationType     ValuationType?      // Theo quy định Quỹ / Theo giá thị trường
  fundLandCategory  FundLandCategory?   // Loại đất theo quy định Quỹ
  unitPrice         Decimal?            @db.Decimal(18, 0) // Mức giá / m2
  valuationAmount   Decimal?            @db.Decimal(18, 0) // Định giá tài sản
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  guarantor Guarantor?

  @@index([loanId])
  @@index([hamletId])
  @@index([communeId])
  @@map("collateral_assets")
}

/// Dòng chi tiết trong Bảng Định giá Tài sản Thế chấp (Section riêng khi vay Thế chấp)
model CollateralValuationItem {
  id               String            @id @default(uuid())
  loanId           String
  loan             Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  plotNumber       String            // Số thửa
  mapSheetNumber   String            // Số tờ
  area             Decimal           @db.Decimal(14, 2) // Diện tích trên sổ (m2)
  actualArea       Decimal?          @db.Decimal(14, 2) // Diện tích thực tế định giá (tùy chọn)
  fundLandCategory FundLandCategory? // Loại đất theo quy định Quỹ (nếu định giá theo quy định Quỹ)
  unitPrice        Decimal           @db.Decimal(18, 0) // Đơn giá / m2
  valuationAmount  Decimal           @db.Decimal(18, 0) // Giá tiền (làm tròn xuống hàng triệu)
  note             String?           // Ghi chú (tùy chọn)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([loanId])
  @@map("collateral_valuation_items")
}

/// Thông tin Người bảo lãnh (1 tài sản bảo lãnh chỉ có 1 người bảo lãnh - địa chỉ nhập tự do)
model Guarantor {
  id                String           @id @default(uuid())
  collateralAssetId String           @unique
  collateralAsset   CollateralAsset  @relation(fields: [collateralAssetId], references: [id], onDelete: Cascade)
  fullName          String
  idType            IdentityCardType
  idNumber          String           @db.VarChar(12)
  issuingAuthority  String
  issueDate         DateTime         @db.Date
  expiryDate        DateTime?        @db.Date
  gender            Gender
  birthYear         Int
  address           String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([idNumber])
  @@map("guarantors")
}

/// Thông tin Người liên quan (Bắt buộc khi vay Thế chấp >= 140.000.000đ - địa chỉ nhập tự do)
model RelatedPerson {
  id                 String                    @id @default(uuid())
  loanId             String
  loan               Loan                      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  fullName           String
  idType             IdentityCardType
  idNumber           String                    @db.VarChar(12)
  issuingAuthority   String
  issueDate          DateTime                  @db.Date
  expiryDate         DateTime?                 @db.Date
  gender             Gender
  birthYear          Int
  address            String
  phone              String?                   @db.VarChar(20)
  relationship       RelatedPersonRelationship
  existingLoanAtFund Decimal?                  @db.Decimal(18, 0) // Vốn vay ở quỹ (null/0 là Không, hoặc số tiền vay)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([loanId])
  @@map("related_persons")
}

/// Thông tin Người trong hộ (Quản lý chung theo Khoản vay khi có tài sản đất hộ, có thể bỏ trống - địa chỉ nhập tự do)
model HouseholdMember {
  id               String           @id @default(uuid())
  loanId           String
  loan             Loan             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  fullName         String
  idType           IdentityCardType
  idNumber         String           @db.VarChar(12)
  issuingAuthority String
  issueDate        DateTime         @db.Date
  expiryDate       DateTime?        @db.Date
  gender           Gender
  birthYear        Int
  address          String
  phone            String?          @db.VarChar(20)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([loanId])
  @@map("household_members")
}

/// Phương án vay vốn (1-1 với Khoản vay)
model LoanPlan {
  id               String         @id @default(uuid())
  loanId           String         @unique
  loan             Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanPurpose      String         // Mục đích vay vốn
  totalCapitalNeed Decimal        @db.Decimal(18, 0) // Tổng nhu cầu vốn (= tổng chi phí)
  fundLoanCapital  Decimal        @db.Decimal(18, 0) // Vốn vay quỹ
  ownCapital       Decimal        @db.Decimal(18, 0) // Vốn tự có (= tổng nhu cầu vốn - vốn vay quỹ)
  totalRevenue     Decimal        @db.Decimal(18, 0) // Tổng nguồn thu
  profit           Decimal        @db.Decimal(18, 0) // Lợi nhuận (= tổng nguồn thu - tổng chi phí)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items LoanPlanItem[]

  @@map("loan_plans")
}

/// Chi tiết các khoản Chi phí và Nguồn thu trong Phương án vay vốn
model LoanPlanItem {
  id         String           @id @default(uuid())
  loanPlanId String
  loanPlan   LoanPlan         @relation(fields: [loanPlanId], references: [id], onDelete: Cascade)
  type       LoanPlanItemType // CHI_PHI / NGUON_THU
  itemName   String           // Tên khoản mục
  amount     Decimal          @db.Decimal(18, 0) // Số tiền
  sortOrder  Int              @default(0)

  @@index([loanPlanId, type])
  @@map("loan_plan_items")
}
